// Trading AI Agent - Complete Database Schema
// Nifty 500 Stocks | Swing Trading | Learning System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// NIFTY 500 STOCKS
// ============================================

model Stock {
  id            String   @id @default(cuid())
  symbol        String   @unique
  name          String?
  sector        String?
  industry      String?
  marketCap     String?  // LARGE, MID, SMALL
  isActive      Boolean  @default(true)
  nseToken      String?
  yahooSymbol   String?  // For Yahoo Finance (e.g., "RELIANCE.NS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dailyCandles  DailyCandle[]
  hourlyCandles HourlyCandle[]
  signals       TradeSignal[]
  watchlistItem WatchlistItem?
  performance   StockPerformance?

  @@index([symbol])
  @@index([isActive])
  @@index([sector])
}

// ============================================
// MARKET DATA - DAILY & HOURLY
// ============================================

model DailyCandle {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id])
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  oi        Float?   // Open Interest
  
  // Technical Indicators (calculated)
  ema20     Float?
  ema50     Float?
  ema200    Float?
  rsi14     Float?
  atr14     Float?
  adx14     Float?
  macd      Float?
  macdSignal Float?
  macdHist  Float?
  
  createdAt DateTime @default(now())

  @@unique([stockId, date])
  @@index([stockId, date])
}

model HourlyCandle {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id])
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  
  createdAt DateTime @default(now())

  @@unique([stockId, timestamp])
  @@index([stockId, timestamp])
}

// ============================================
// DATA SESSION TRACKING
// ============================================

model DataSession {
  id            String   @id @default(cuid())
  lastDate      DateTime // Last date data was fetched
  timeframe     String   // DAILY, HOURLY
  stocksUpdated Int      @default(0)
  status        String   @default("COMPLETED") // RUNNING, COMPLETED, FAILED
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// TRADE SIGNALS (Generated by AI)
// ============================================

model TradeSignal {
  id              String   @id @default(cuid())
  stockId         String
  stock           Stock    @relation(fields: [stockId], references: [id])
  
  // Signal Details
  signalType      String   // BUY, SELL
  status          String   @default("PENDING") // PENDING, ACTIVE, SUCCESS, LOSS, CANCELLED
  confidence      Float    // 0-100 (must be >= 80 to be generated)
  
  // Entry/Exit
  entryPrice      Float
  stopLoss        Float
  targetPrice     Float
  riskReward      Float
  
  // Analysis Context
  timeframe       String   // DAILY, HOURLY
  trendDirection  String?  // BULLISH, BEARISH
  regime          String?  // TRENDING, RANGING
  confluenceScore Float?   // Combined score from multiple indicators
  
  // Reasoning
  reasoning       String?  // AI analysis reasoning
  indicators      String?  // JSON of indicator values at signal time
  
  // Dates
  generatedAt     DateTime @default(now())
  validTill       DateTime? // 5 trading days from generation
  activatedAt     DateTime?
  closedAt        DateTime?
  
  // Tracking
  tracking        SignalTracking?
  
  @@index([status, generatedAt])
  @@index([stockId])
}

// ============================================
// SIGNAL TRACKING (5-Day Holding)
// ============================================

model SignalTracking {
  id              String   @id @default(cuid())
  signalId        String   @unique
  signal          TradeSignal @relation(fields: [signalId], references: [id])
  
  // Tracking Dates
  day1Date        DateTime?
  day1High        Float?
  day1Low         Float?
  day1Close       Float?
  
  day2Date        DateTime?
  day2High        Float?
  day2Low         Float?
  day2Close       Float?
  
  day3Date        DateTime?
  day3High        Float?
  day3Low         Float?
  day3Close       Float?
  
  day4Date        DateTime?
  day4High        Float?
  day4Low         Float?
  day4Close       Float?
  
  day5Date        DateTime?
  day5High        Float?
  day5Low         Float?
  day5Close       Float?
  
  // Result
  maxProfit       Float?   // Maximum profit % during holding
  maxLoss         Float?   // Maximum loss % during holding
  finalResult     String?  // SUCCESS, LOSS, BREAKEVEN
  finalPnlPercent Float?
  
  // Learning
  analyzedForLearning Boolean @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// LEARNING SYSTEM
// ============================================

model LearningRecord {
  id              String   @id @default(cuid())
  
  // Signal Reference
  signalId        String?
  
  // Setup Characteristics
  setupType       String   // BREAKOUT, PULLBACK, REVERSAL, etc.
  trendDirection  String?
  regime          String?
  volumeProfile   String?  // HIGH, NORMAL, LOW
  
  // Context
  sector          String?
  marketCap       String?
  dayOfWeek       Int?     // 0-6
  month           Int?     // 1-12
  
  // Result
  result          String   // SUCCESS, LOSS, BREAKEVEN
  pnlPercent      Float?
  maxDrawdown     Float?   // Max loss during trade
  maxProfit       Float?   // Max profit during trade
  
  // Learning Insights
  whatWorked      String?  // What went right
  whatFailed      String?  // What went wrong
  improvement     String?  // How to improve
  
  createdAt       DateTime @default(now())
  
  @@index([setupType, result])
  @@index([result])
}

model StrategyPerformance {
  id              String   @id @default(cuid())
  
  // Strategy Identity
  strategyName    String   @unique
  description     String?
  
  // Statistics
  totalSignals    Int      @default(0)
  successCount    Int      @default(0)
  lossCount       Int      @default(0)
  breakevenCount  Int      @default(0)
  successRate     Float    @default(0)
  
  // Performance Metrics
  avgProfit       Float    @default(0)
  avgLoss         Float    @default(0)
  avgHoldDays     Float    @default(0)
  maxProfit       Float    @default(0)
  maxLoss         Float    @default(0)
  profitFactor    Float    @default(0)
  
  // Risk Metrics
  avgRiskReward   Float    @default(0)
  avgDrawdown     Float    @default(0)
  
  // Learning
  lastLearnedAt   DateTime?
  improvementLog  String?  // JSON array of improvements made
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StockPerformance {
  id              String   @id @default(cuid())
  stockId         String   @unique
  stock           Stock    @relation(fields: [stockId], references: [id])
  
  // Signal Statistics
  totalSignals    Int      @default(0)
  successCount    Int      @default(0)
  lossCount       Int      @default(0)
  successRate     Float    @default(0)
  
  // Performance
  totalPnl        Float    @default(0)
  avgPnl          Float    @default(0)
  maxProfit       Float    @default(0)
  maxLoss         Float    @default(0)
  
  // Tracking
  lastSignalAt    DateTime?
  lastSuccessAt   DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// WATCHLIST (80%+ Success Rate)
// ============================================

model Watchlist {
  id          String   @id @default(cuid())
  name        String   @default("High Accuracy Stocks")
  description String?
  isDefault   Boolean  @default(false)
  
  items       WatchlistItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id])
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id])
  
  // Performance Summary
  successRate Float    @default(0)
  totalSignals Int     @default(0)
  avgPnl      Float    @default(0)
  
  // Status
  addedAt     DateTime @default(now())
  lastUpdated DateTime @default(now())
}

// ============================================
// MARKET CALENDAR (NSE)
// ============================================

model TradingDay {
  id          String   @id @default(cuid())
  date        DateTime @unique
  isTrading   Boolean  @default(true)
  isHoliday   Boolean  @default(false)
  holidayName String?
  
  createdAt   DateTime @default(now())
  
  @@index([date])
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  description     String?
  
  updatedAt       DateTime @updatedAt
}

// ============================================
// SYSTEM LOGS
// ============================================

model SystemLog {
  id          String   @id @default(cuid())
  level       String   // INFO, WARNING, ERROR
  category    String   // DATA, ANALYSIS, SIGNAL, LEARNING, SYSTEM
  message     String
  details     String?  // JSON
  symbol      String?
  
  createdAt   DateTime @default(now())
  
  @@index([level, category, createdAt])
}

// ============================================
// ANALYSIS RUN HISTORY
// ============================================

model AnalysisRun {
  id              String   @id @default(cuid())
  type            String   // FULL, INCREMENTAL
  status          String   // RUNNING, COMPLETED, FAILED
  
  // Scope
  stocksAnalyzed  Int      @default(0)
  timeframe       String?  // DAILY, HOURLY, BOTH
  
  // Results
  signalsGenerated Int     @default(0)
  highAccuracySignals Int  @default(0) // 80%+ confidence
  
  // Timing
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?
  
  error           String?
  
  @@index([type, startedAt])
}
